{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dash",
  "version": "0.2.0",
  "identifier": "com.dash.quickcapture",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Dash",
        "url": "index.html",
        "width": 900,
        "height": 640,
        "minWidth": 420,
        "minHeight": 360,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "quick",
        "title": "Quick Add",
        "url": "quick.html",
        "width": 440,
        "height": 204,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Quick-capture to-do app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  },
  "plugins": {}
}
